import ts from 'typescript';
import { lexer } from 'css-tree';
import { readFileSync, writeFileSync } from 'node:fs';
import { createRequire } from 'node:module';
import { resolve } from 'node:path';
import { canon_to_css_prop } from '../src/api/transform/utils/attrs-utils/normalize-css.js';
const require = createRequire(import.meta.url);

// Local standards-derived vocabularies: css-tree's MDN data plus TypeScript's generated
// CSSStyleDeclaration. Refresh after either dependency changes; no runtime import of either.
// Display 4 is not yet in these installed datasets. Keep its complete new reading-order
// family together, and retire supplements once the upstream datasets include them.
// https://drafts.csswg.org/css-display-4/#reading-flow
// https://drafts.csswg.org/css-display-4/#reading-order
const supplement = ['reading-flow', 'reading-order'];
export function css_property_inventory(): string[] {
  const names = new Set(Object.keys(Reflect.get(lexer, 'properties')).filter(name => name !== '--*'));
  const file = ts.createSourceFile('lib.dom.d.ts', readFileSync(require.resolve('typescript/lib/lib.dom.d.ts'), 'utf8'), ts.ScriptTarget.Latest, true);
  const declaration = file.statements.find(node => ts.isInterfaceDeclaration(node) && node.name.text === 'CSSStyleDeclaration');
  if (!declaration || !ts.isInterfaceDeclaration(declaration)) throw new Error('Missing CSSStyleDeclaration inventory.');
  for (const member of declaration.members) {
    if (ts.isPropertySignature(member) && member.type?.kind === ts.SyntaxKind.StringKeyword && member.name) {
      const name = member.name.getText(file);
      if (name !== 'cssText') names.add(canon_to_css_prop(name));
    }
  }
  for (const name of supplement) names.add(name);
  return [...names].sort();
}
if (process.argv[1] && resolve(process.argv[1]) === resolve(import.meta.filename)) {
  const path = new URL('../src/core/css-properties.ts', import.meta.url);
  const current = readFileSync(path, 'utf8');
  const marker = current.indexOf('type InventoryProperty');
  if (marker < 0) throw new Error('Missing inventory type marker.');
  const header = '// Generated by scripts/css-property-inventory.mts from installed css-tree MDN data,\n'
    + '// TypeScript CSSStyleDeclaration, and the documented CSS Display 4 supplement.\n'
    + '// Refresh: node --import=tsx scripts/css-property-inventory.mts; regression tests detect drift.\n';
  writeFileSync(path, `${header}export const CSS_PROPERTY_NAMES = [\n${css_property_inventory().map(name => `  ${JSON.stringify(name)},`).join('\n')}\n] as const;\n${current.slice(marker)}`);
}
