{
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@support/*": ["./support/*"],
      "hson-live": ["../../../dist/index.d.ts"],
      "hson-live/hson": ["../../../dist/hson-authoring.d.ts"],
      "hson-live/livemap": ["../../../dist/api/livemap/index.d.ts"]
    },
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "incremental": true,
    "tsBuildInfoFile": "./authored.tsbuildinfo",
    "outDir": "./out"
  }
}
