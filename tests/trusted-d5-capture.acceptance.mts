await check('one current evaluation associates without successful application validation',async()=>assert.equal((await runtime.handle(request)).type,'associated'));
await check('stale source revision is unavailable',async()=>assert.equal((await runtime.handle({...request,directSource:{...directSource,interpolation:{...directSource.interpolation,sourceRevision:'stale'}}})).error,'ASSOCIATION_UNAVAILABLE'));
await check('stale generation is unavailable',async()=>assert.equal((await runtime.handle({...request,runtimeGeneration:8})).error,'ASSOCIATION_UNAVAILABLE'));
await check('unknown evaluation ID is unavailable',async()=>assert.equal((await runtime.handle({...request,directSource:{...directSource,interpolation:{...directSource.interpolation,evaluationId:'other'}}})).error,'ASSOCIATION_UNAVAILABLE'));
await check('equal repeated executions remain ambiguous',async()=>{const s=discover_schema_validation_sources(caseFile('repeated'),cases.repeated!)[0]!;const c=loaded.captures!.find(c=>c.site.templateId===s.interpolation!.templateId)!;assert.equal((await runtime.handle({...request,directSource:{...directSource,templateId:s.templateId,callId:s.callId,interpolation:{templateId:c.site.templateId,sourceRevision:c.site.sourceRevision,evaluationId:c.evaluationId}}})).error,'AMBIGUOUS_REGISTRATION');});
await check('admission failure evidence exists without any Schema call',()=>assert.ok(loaded.captures!.some(c=>c.site.moduleUrl.endsWith('d5-unsupported.ts')&&c.failure?.substitution===0)));
await check('current capture request is request-bound and source-filtered',async()=>{const r=await runtime.handle({...env,type:'captures',requestId:'fresh-capture',moduleUrl:capture.site.moduleUrl});assert.equal(r.requestId,'fresh-capture');assert.equal(r.type,'captured');assert.equal(r.captures?.length,1);});
await check('evaluation repeated after association invalidates authority',async()=>{
  assert.equal((await runtime.handle(request)).type,'associated');
