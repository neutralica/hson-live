await check('uncaught provider admission failure retains trace and failure status',async()=>{
  const r=await new TrustedSchemaDiagnosticRuntime(8).handle({...env,runtimeGeneration:8,type:'load',moduleUrl:new URL('./fixtures/schema-d5-uncaught.fixture.mts',import.meta.url).href,hsonModuleUrl:new URL('../src/hson.ts',import.meta.url).href});
  assert.equal(r.type,'loaded',r.message);assert.ok(r.loadFailure);assert.doesNotMatch(r.loadFailure!,/Unreachable/);assert.equal(r.captures?.[0]?.failure?.substitution,0);
