{
  "$schema": "vscode://schemas/color-theme",
  "name": "Hson House Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#0f141a",
    "editor.foreground": "#D8DEE8",
    "foreground": "#D8DEE8",
    "focusBorder": "#8CC7D9",
    "editor.selectionBackground": "#30485E",
    "editor.lineHighlightBackground": "#1B222C",
    "editorCursor.foreground": "#8CC7D9",
    "editorLineNumber.foreground": "#939daa",
    "editorLineNumber.activeForeground": "#D8DEE8",
    "sideBar.background": "#1B222C",
    "sideBar.foreground": "#D8DEE8",
    "sideBar.border": "#34404E",
    "activityBar.background": "#1B222C",
    "activityBar.foreground": "#D8DEE8",
    "statusBar.background": "#1B222C",
    "statusBar.foreground": "#D8DEE8",
    "titleBar.activeBackground": "#1B222C",
    "titleBar.activeForeground": "#D8DEE8",
    "editorGroupHeader.tabsBackground": "#1B222C",
    "tab.activeBackground": "#0f141a",
    "tab.activeForeground": "#D8DEE8",
    "tab.inactiveBackground": "#1B222C",
    "panel.background": "#1B222C",
    "panel.border": "#34404E",
    "input.background": "#0f141a",
    "input.foreground": "#D8DEE8",
    "input.border": "#34404E",
    "list.activeSelectionBackground": "#30485E",
    "list.activeSelectionForeground": "#D8DEE8",
    "editorBracketHighlight.foreground1": "#7f718b",
    "editorBracketHighlight.foreground2": "#86b7c6",
    "editorBracketHighlight.foreground3": "#9989b6",
    "editorBracketHighlight.foreground4": "#7f718b",
    "editorBracketHighlight.foreground5": "#86b7c6",
    "editorBracketHighlight.foreground6": "#9989b6"
  },
  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#939daa"
      }
    },
    {
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#abb0b0"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d8b78f"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "constant.language"
      ],
      "settings": {
        "foreground": "#b8b5dd"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type"
      ],
      "settings": {
        "foreground": "#c6caca"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#b685af"
      }
    },
    {
      "scope": [
        "variable",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#84a9d6"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#7f718b"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#d4ba86"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#f08b94"
      }
    },
    {
      "scope": [
        "entity.name.type.hson",
        "entity.name.type.quoted.hson"
      ],
      "settings": {
        "foreground": "#c6caca"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.hson"
      ],
      "settings": {
        "foreground": "#84a9d6"
      }
    },
    {
      "scope": [
        "constant.language.flag.hson"
      ],
      "settings": {
        "foreground": "#6d9dd8"
      }
    },
    {
      "scope": [
        "keyword.other.directive.hson"
      ],
      "settings": {
        "foreground": "#9989b6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.receiving.hson"
      ],
      "settings": {
        "foreground": "#86b7c6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.sending.hson"
      ],
      "settings": {
        "foreground": "#b685af"
      }
    },
    {
      "scope": [
        "keyword.control.iteration.hson"
      ],
      "settings": {
        "foreground": "#ac9f88"
      }
    },
    {
      "scope": [
        "keyword.operator.interpolation.caret.hson"
      ],
      "settings": {
        "foreground": "#b6b2a9"
      }
    },
    {
      "scope": [
        "keyword.operator.interpolation.percent.hson"
      ],
      "settings": {
        "foreground": "#9b9a85"
      }
    },
    {
      "scope": [
        "string.quoted.double.hson",
        "string.unquoted.attribute-value.hson"
      ],
      "settings": {
        "foreground": "#abb0b0"
      }
    },
    {
      "scope": [
        "constant.numeric.hson"
      ],
      "settings": {
        "foreground": "#d8b78f"
      }
    },
    {
      "scope": [
        "constant.language.boolean.hson",
        "constant.language.null.hson"
      ],
      "settings": {
        "foreground": "#b8b5dd"
      }
    },
    {
      "scope": [
        "keyword.declaration.part.hson"
      ],
      "settings": {
        "foreground": "#9989b6"
      }
    },
    {
      "scope": [
        "constant.other.quid.hson"
      ],
      "settings": {
        "foreground": "#c4ade2"
      }
    },
    {
      "scope": [
        "constant.other.quad.hson"
      ],
      "settings": {
        "foreground": "#c4ade2"
      }
    },
    {
      "scope": [
        "punctuation.definition.identity.hson"
      ],
      "settings": {
        "foreground": "#c4ade2"
      }
    },
    {
      "scope": [
        "comment.line.double-slash.hson",
        "punctuation.definition.comment.hson"
      ],
      "settings": {
        "foreground": "#939daa"
      }
    },
    {
      "scope": [
        "punctuation.definition.tag.begin.hson",
        "punctuation.definition.tag.end.hson",
        "punctuation.definition.tag.self-closing.hson",
        "punctuation.section.array.begin.hson",
        "punctuation.section.array.end.hson",
        "punctuation.separator.sequence.hson"
      ],
      "settings": {
        "foreground": "#7f718b"
      }
    },
    {
      "scope": [
        "keyword.operator.assignment.hson",
        "keyword.operator.interpolation.dollar.hson"
      ],
      "settings": {
        "foreground": "#8f8497"
      }
    },
    {
      "scope": [
        "punctuation.separator.attribute.hson",
        "punctuation.separator.identity.hson"
      ],
      "settings": {
        "foreground": "#5b7594"
      }
    },
    {
      "scope": [
        "constant.character.escape.hson"
      ],
      "settings": {
        "foreground": "#d4ba86"
      }
    },
    {
      "scope": [
        "invalid.illegal.hson"
      ],
      "settings": {
        "foreground": "#f08b94"
      }
    },
    {
      "scope": [
        "variable.other.property.hson",
        "punctuation.accessor.hson",
        "punctuation.section.selector.begin.hson",
        "punctuation.section.selector.end.hson"
      ],
      "settings": {
        "foreground": "#d99db5"
      }
    },
    {
      "scope": [
        "punctuation.definition.template-expression.begin.hson",
        "punctuation.definition.template-expression.end.hson"
      ],
      "settings": {
        "foreground": "#7f718b"
      }
    },
    {
      "scope": [
        "punctuation.definition.string.begin.hson",
        "punctuation.definition.string.end.hson"
      ],
      "settings": {
        "foreground": "#778571"
      }
    },
    {
      "scope": [
        "meta.attribute.qualifier.hson"
      ],
      "settings": {
        "foreground": "#8792a0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.receiving.hson meta.attribute.qualifier.hson"
      ],
      "settings": {
        "foreground": "#86b7c6"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.receiving.hson meta.attribute.local-name.hson"
      ],
      "settings": {
        "foreground": "#8792a0"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#c6caca",
    "class": "#c6caca",
    "interface": "#c6caca",
    "enum": "#c6caca",
    "typeParameter": "#c6caca",
    "namespace": "#c6caca",
    "variable": "#84a9d6",
    "parameter": "#84a9d6",
    "property": "#84a9d6",
    "function": "#b685af",
    "method": "#b685af",
    "enumMember": "#d8b78f",
    "hsonType": "#c6caca",
    "hsonProperty": "#84a9d6",
    "hsonFlag": "#6d9dd8",
    "hsonDirective": "#9989b6",
    "hsonReceiving": "#86b7c6",
    "hsonSending": "#b685af",
    "hsonIteration": "#ac9f88",
    "hsonLocalReferenceSigil": "#b6b2a9",
    "hsonIncomingReferenceSigil": "#9b9a85",
    "hsonString": "#abb0b0",
    "hsonNumber": "#d8b78f",
    "hsonKeyword": "#b8b5dd",
    "hsonDeclaration": "#9989b6",
    "hsonQuid": "#c4ade2",
    "hsonQuad": "#c4ade2",
    "hsonIdentityMarker": "#c4ade2",
    "hsonComment": "#939daa",
    "hsonDelimiter": "#7f718b",
    "hsonOperator": "#8f8497",
    "hsonColon": "#5b7594",
    "hsonEscape": "#d4ba86",
    "hsonInvalid": "#f08b94",
    "hsonReference": "#d99db5",
    "hsonInterpolationDelimiter": "#7f718b",
    "hsonQuote": "#778571",
    "*.hsonQualifier": "#8792a0",
    "hsonReceiving.hsonQualifier": "#86b7c6",
    "hsonReceiving.hsonLocalName": "#8792a0"
  }
}
