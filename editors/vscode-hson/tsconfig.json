{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": false,
    "noEmit": true,
    "types": ["node", "vscode"]
  },
  "include": [
    "src/**/*.ts",
    "tests/runtime.test.ts",
    "tests/workspace-diagnostics.test.ts",
    "tests/settings.test.ts",
    "tests/benchmark.ts",
    "tests/integration/suite.ts",
    "tests/integration/baseline.ts",
    "tests/baseline.test.ts"
  ],
  "exclude": ["src/tsserver-plugin/**/*"]
}
