{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hson fenced code blocks in Markdown",
  "scopeName": "markdown.hson.codeblock",
  "injectionSelector": "L:markup.fenced_code.block.markdown",
  "patterns": [
    { "include": "#hson-backtick-code-block" },
    { "include": "#hson-tilde-code-block" }
  ],
  "repository": {
    "hson-backtick-code-block": {
      "begin": "(?<=^ {0,3}(`{3,}))hson(\\s+[^`~]*)?$",
      "end": "(^|\\G)(?= {0,3}\\1`*[ \\t]*$)",
      "contentName": "meta.embedded.block.hson",
      "patterns": [
        { "include": "source.hson" }
      ]
    },
    "hson-tilde-code-block": {
      "begin": "(?<=^ {0,3}(~{3,}))hson(\\s+[^`~]*)?$",
      "end": "(^|\\G)(?= {0,3}\\1~*[ \\t]*$)",
      "contentName": "meta.embedded.block.hson",
      "patterns": [
        { "include": "source.hson" }
      ]
    }
  }
}
