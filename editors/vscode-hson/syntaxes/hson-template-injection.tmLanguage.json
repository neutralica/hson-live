{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HSON in direct hson tagged templates",
  "scopeName": "source.hson.template.injection",
  "injectionSelector": "L:source.ts -comment -string, L:source.tsx -comment -string",
  "patterns": [
    {
      "name": "meta.tagged-template.hson",
      "contentName": "meta.embedded.block.hson",
      "begin": "(?<![A-Za-z0-9_$.])\\b(hson)([ \\t]*)(`)",
      "beginCaptures": {
        "1": { "name": "support.function.tagged-template.hson" },
        "3": { "name": "punctuation.definition.string.template.begin.ts" }
      },
      "end": "(?<!\\\\)(?:\\\\\\\\)*\\K`",
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.template.end.ts" }
      },
      "patterns": [
        {
          "name": "meta.interpolation.ts",
          "contentName": "meta.embedded.expression.ts",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.ts" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.ts" }
          },
          "patterns": [
            { "include": "#typescript-braces" },
            { "include": "source.ts" }
          ]
        },
        {
          "name": "constant.character.escape.ts",
          "match": "\\\\`"
        },
        { "include": "source.hson" }
      ]
    }
  ],
  "repository": {
    "typescript-braces": {
      "name": "meta.brace.object.ts",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.block.ts" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.ts" }
      },
      "patterns": [
        { "include": "#typescript-braces" },
        { "include": "source.ts" }
      ]
    }
  }
}
