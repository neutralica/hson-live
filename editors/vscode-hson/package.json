{
  "name": "hson-language",
  "displayName": "HSON Language",
  "description": "Syntax highlighting and authoritative diagnostics for HSON files and supported HSON tagged templates.",
  "version": "0.1.1",
  "publisher": "terminal-gothic",
  "repository": { "type": "git", "url": "https://github.com/neutralica/hson-live.git", "directory": "editors/vscode-hson" },
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax tooling works in Restricted Mode. Trusted Schema diagnostics execute project code only with Workspace Trust and explicit enablement.",
      "restrictedConfigurations": ["hson.trustedSchemaDiagnostics.enabled", "hson.trustedSchemaDiagnostics.module", "hson.trustedSchemaDiagnostics.hsonModule", "hson.trustedSchemaDiagnostics.runtimeEntry", "hson.trustedSchemaDiagnostics.execArgv"]
    }
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check": "tsc -p ./tsconfig.json --noEmit && node ./tests/validate-artifact.mjs",
    "test": "npm run test:grammar && npm run test:unit",
    "test:grammar": "node ./tests/grammar.test.mjs && npm run test:baseline",
    "test:unit": "node ./scripts/build-tests.mjs && node ./.test-dist/unit.cjs",
    "test:integration": "npm run build && node ./scripts/build-tests.mjs && node ./tests/integration/run.mjs",
    "test:baseline": "npm run build && node ./scripts/build-tests.mjs && node ./.test-dist/baseline.cjs",
    "test:baseline:integration": "npm run build && node ./scripts/build-tests.mjs && node ./tests/integration/run-baseline.mjs",
    "test:baseline:installed": "npm run package:vsix && node ./scripts/build-tests.mjs && HSON_BASELINE_VSIX=hson-language.vsix node ./tests/integration/run-baseline.mjs",
    "benchmark": "node ./scripts/build-tests.mjs && node ./.test-dist/benchmark.cjs",
    "package:dry-run": "npm run build && vsce ls --tree",
    "package:vsix": "npm run build && vsce package --no-dependencies --out hson-language.vsix"
  },
  "contributes": {
    "configuration": {
      "title": "HSON trusted Schema diagnostics",
      "properties": {
        "hson.trustedSchemaDiagnostics.enabled": { "type": "boolean", "default": false, "scope": "resource", "description": "Explicitly allow trusted project Schema execution. Also requires Workspace Trust. Not a sandbox." },
        "hson.trustedSchemaDiagnostics.module": { "type": "string", "default": "", "scope": "resource", "description": "Trusted Schema registration module path relative to the workspace folder. Prefer a Schema-only module, not the application entrypoint." },
        "hson.trustedSchemaDiagnostics.hsonModule": { "type": "string", "default": "", "scope": "resource", "description": "Path to the project's hson.js facade (same runtime instance as its private D1 entry)." },
        "hson.trustedSchemaDiagnostics.runtimeEntry": { "type": "string", "default": "", "scope": "resource", "description": "Optional private D1 Node entry path; defaults beside hson.js under internal/trusted-schema-diagnostics." },
        "hson.trustedSchemaDiagnostics.execArgv": { "type": "array", "items": { "type": "string" }, "default": [], "scope": "resource", "description": "Explicit trusted Node loader arguments, if required by the configured project runtime." }
      }
    },
    "languages": [
      {
        "id": "hson",
        "aliases": [
          "HSON",
          "hson"
        ],
        "extensions": [
          ".hson"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hson",
        "scopeName": "source.hson",
        "path": "./syntaxes/hson.tmLanguage.json"
      }
    ],
    "colors": [
      {
        "id": "hson.authoringMarker.h",
        "description": "HSON authoring marker: H (blue).",
        "defaults": { "dark": "#74A7D8", "light": "#356A9A", "highContrast": "#66B3FF", "highContrastLight": "#005FB8" }
      },
      {
        "id": "hson.authoringMarker.s",
        "description": "HSON authoring marker: S (yellow).",
        "defaults": { "dark": "#D2B45F", "light": "#786422", "highContrast": "#FFD166", "highContrastLight": "#8A6200" }
      },
      {
        "id": "hson.authoringMarker.o",
        "description": "HSON authoring marker: O (pink).",
        "defaults": { "dark": "#D789AE", "light": "#8E4768", "highContrast": "#FF80BF", "highContrastLight": "#B0005A" }
      },
      {
        "id": "hson.authoringMarker.n",
        "description": "HSON authoring marker: N (green).",
        "defaults": { "dark": "#78B996", "light": "#3E7256", "highContrast": "#6EE7A8", "highContrastLight": "#147A3D" }
      }
    ],
    "semanticTokenTypes": [
      { "id": "hsonType", "superType": "type", "description": "HSON grammar name" },
      { "id": "hsonProperty", "superType": "property", "description": "HSON grammar attribute" },
      { "id": "hsonString", "superType": "string", "description": "HSON grammar string" },
      { "id": "hsonNumber", "superType": "number", "description": "HSON grammar number" },
      { "id": "hsonKeyword", "superType": "keyword", "description": "HSON grammar constant" },
      { "id": "hsonQuid", "superType": "string", "description": "HSON QUID literal" },
      { "id": "hsonComment", "superType": "comment", "description": "HSON grammar comment" },
      { "id": "hsonDelimiter", "superType": "operator", "description": "HSON grammar delimiter" },
      { "id": "hsonOperator", "superType": "operator", "description": "HSON grammar punctuation" },
      { "id": "hsonEscape", "superType": "string", "description": "HSON grammar escape" },
      { "id": "hsonInvalid", "description": "HSON grammar invalid token" }
    ],
    "semanticTokenScopes": [{ "scopes": {
      "hsonType": ["entity.name.type.hson"],
      "hsonProperty": ["entity.other.attribute-name.hson"],
      "hsonString": ["string.quoted.double.hson", "string.unquoted.attribute-value.hson"],
      "hsonNumber": ["constant.numeric.hson"],
      "hsonKeyword": ["constant.language.boolean.hson", "constant.language.null.hson"],
      "hsonQuid": ["constant.other.quid.hson"],
      "hsonComment": ["comment.line.double-slash.hson"],
      "hsonDelimiter": ["punctuation.definition.tag.begin.hson", "punctuation.definition.tag.end.hson", "punctuation.section.array.begin.hson", "punctuation.section.array.end.hson", "punctuation.separator.sequence.hson", "punctuation.definition.comment.hson", "punctuation.definition.string.begin.hson", "punctuation.definition.string.end.hson"],
      "hsonOperator": ["keyword.operator.assignment.hson"],
      "hsonEscape": ["constant.character.escape.hson"],
      "hsonInvalid": ["invalid.illegal.hson"]
    }}]
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.9",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
